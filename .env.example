# Local: postgres://USER:PASSWORD@127.0.0.1:5432/unified_front_door
# Neon runtime: pooled connection string with TLS verification enabled.
DATABASE_URL=
# Direct connection required for remote migrations/status; local Postgres may use DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Explicit isolated test database only; integration tests create and remove their own namespaces.
DATABASE_TEST_URL=
# Direct URL for the same disposable test database (required for a remote release gate).
DATABASE_TEST_URL_UNPOOLED=
# Exact externally visible origin, including the localhost port. Workers also
# use this URL and Basic Auth to wait for activity without querying Postgres.
APP_ORIGIN=http://localhost:3000
BASIC_AUTH_USER=guest
BASIC_AUTH_PASSWORD=

# Optional bounded text reasoning. Demo remains the default; assessment data is still demo.
AGENT_PROVIDER="demo"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
# Optional provider workspace isolation (wrkspc_...).
ANTHROPIC_WORKSPACE_ID=""
# Daily attempted calls, not a dollar cap. Caps can only decrease within a UTC day.
AGENT_GLOBAL_DAILY_CALLS="10"
AGENT_NAMESPACE_DAILY_CALLS="5"
